# ------------------------------------------------------------------------------
# Apache Configuration for Next.js Static Export on cPanel / Shared Hosting
# ------------------------------------------------------------------------------

# Disable directory listing to prevent index leaks
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ensure HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Legacy product shortcuts
    RewriteRule ^openmail/?$ /projects/openmail/ [R=301,L]
    RewriteRule ^mercura/?$ /projects/mercura/ [R=301,L]
    RewriteRule ^m31a/?$ /projects/m31a/ [R=301,L]
    RewriteRule ^octate/?$ /projects/octate/ [R=301,L]
    RewriteRule ^m31genesis/?$ /projects/m31genesis/ [R=301,L]
    RewriteRule ^m31tesla/?$ /projects/m31tesla/ [R=301,L]
    RewriteRule ^m31entropy/?$ /projects/m31entropy/ [R=301,L]

    # If requested directory exists but missing trailing slash, enforce slash
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ $1/ [L,R=301]

    # If directory with index.html exists, rewrite clean path to trailing slash
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ /$1/ [L,R=301]

    # Clean URL fallback to .html file if directory does not exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)/?$ /$1.html [L]
</IfModule>

# Custom 404 handler pointing to Next.js export 404 page
ErrorDocument 404 /404.html

# Cache expiration settings
<IfModule mod_expires.c>
    ExpiresActive On

    # Immutable static Next.js assets
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # Images and assets
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 week"

    # Dynamic/HTML pages must revalidate
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Caching and Security Headers
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2|woff)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(html|txt)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Proper MIME types
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
    AddType text/plain .txt
</IfModule>
