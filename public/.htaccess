# ------------------------------------------------------------------------------
# Apache Configuration for Next.js Static Export on cPanel / Shared Hosting
# ------------------------------------------------------------------------------

# Disable directory listing to prevent index leaks
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# Disable automatic mod_dir trailing slash redirects to prevent HTTP downgrade loops behind reverse proxy / CDN
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --------------------------------------------------------------------------
    # 1. SUBDOMAIN ISOLATION (CRITICAL FOR 20i / cPanel)
    # --------------------------------------------------------------------------
    # In shared hosting (20i StackCP, cPanel), subdomains like email.tonmoyinfrastructure.org
    # and openmail.tonmoyinfrastructure.org often have document roots inside public_html/
    # (e.g. public_html/email and public_html/openmail).
    #
    # Because Apache inherits parent .htaccess files, the main site's rewrite rules
    # execute on all subdomains. We immediately halt rewriting if the host is a subdomain.
    RewriteCond %{HTTP_HOST} !^(www\.)?tonmoyinfrastructure\.org$ [NC]
    RewriteRule ^ - [L]

    # --------------------------------------------------------------------------
    # 2. HTTPS ENFORCEMENT (StackCDN / Cloudflare / Reverse Proxy Compatible)
    # --------------------------------------------------------------------------
    # 20i StackCDN and Cloudflare terminate SSL at the edge and proxy requests to
    # the Apache backend over HTTP while passing X-Forwarded-Proto: https.
    # A blind "RewriteCond %{HTTPS} off" check triggers an infinite 301 loop (ERR_TOO_MANY_REDIRECTS).
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:X-Forwarded-SSL} !on
    RewriteCond %{ENV:HTTPS} !on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --------------------------------------------------------------------------
    # 3. DIRECTORY SHORTCUTS & SUBDOMAIN FORWARDING (Main domain only)
    # --------------------------------------------------------------------------
    # If accessed directly via main domain path, route email to its subdomain
    RewriteRule ^email(/.*)?$ https://email.tonmoyinfrastructure.org$1 [R=301,L]

    # Legacy product shortcuts (direct canonical targets with trailing slash and HTTPS)
    RewriteRule ^openmail/?$ https://%{HTTP_HOST}/projects/openmail/ [R=301,L]
    RewriteRule ^mercura/?$ https://%{HTTP_HOST}/projects/mercura/ [R=301,L]
    RewriteRule ^m31a/?$ https://%{HTTP_HOST}/projects/m31a/ [R=301,L]
    RewriteRule ^octate/?$ https://%{HTTP_HOST}/projects/octate/ [R=301,L]
    RewriteRule ^m31genesis/?$ https://%{HTTP_HOST}/projects/m31genesis/ [R=301,L]
    RewriteRule ^m31tesla/?$ https://%{HTTP_HOST}/projects/m31tesla/ [R=301,L]
    RewriteRule ^m31entropy/?$ https://%{HTTP_HOST}/projects/m31entropy/ [R=301,L]

    # --------------------------------------------------------------------------
    # 4. NEXT.JS STATIC ROUTING & TRAILING SLASH (Main domain only)
    # --------------------------------------------------------------------------
    # Next.js export with trailingSlash: true creates folder/index.html.
    # Enforce trailing slash on directories with explicit HTTPS to prevent 404, HTTP downgrade or index leak.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]

    # Clean URL fallback to .html file if directory does not exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)/?$ /$1.html [L]

    # --------------------------------------------------------------------------
    # 5. BRACKETED CHUNK FALLBACK (For cPanel/20i File Manager unzipping)
    # --------------------------------------------------------------------------
    # Some file managers (such as 20i / cPanel) strip square brackets [ ] from folder
    # names during upload or unzipping (e.g. converting [slug] to slug).
    # If a requested chunk has brackets and does not exist on disk, rewrite to the
    # unbracketed directory name so Next.js dynamic routes hydrate without ChunkLoadError.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(_next/static/chunks/.+)(?:\[|%5[bB])([^/\]%]+)(?:\]|%5[dD])(.*)$ /$1$2$3 [L]
</IfModule>

# Custom 404 handler pointing to Next.js export 404 page
ErrorDocument 404 /404.html

# Cache expiration settings
<IfModule mod_expires.c>
    ExpiresActive On

    # Immutable static Next.js assets
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # Images and assets
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 week"

    # Dynamic/HTML pages must revalidate
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Caching and Security Headers
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2|woff)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(html|txt|xml)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Proper MIME types
<IfModule mod_mime.c>
    AddType "application/xml; charset=utf-8" .xml
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
    AddType text/plain .txt
</IfModule>
