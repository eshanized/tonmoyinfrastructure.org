# Canonical Production Site URL for Tonmoy Infrastructure and Vision (TIV)
NEXT_PUBLIC_SITE_URL=https://tonmoyinfrastructure.org/

# Optional Search Engine Console Verifications
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─── Contact Form Serverless Delivery Configuration ──────────────────────────
# Client Endpoint override (defaults to '/api/contact' or provider-native route)
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://your-function-domain.example.com/api/contact

# Option A: Webhook Delivery (Slack, Discord, internal ticketing service)
# CONTACT_FORWARD_WEBHOOK_URL=https://hooks.slack.com/services/...

# Option B: Resend Email Dispatch (Server-side secrets only; never expose in frontend)
# RESEND_API_KEY=re_1234567890abcdef
# CONTACT_RECIPIENT_EMAIL=contact@tonmoyinfrastructure.org
